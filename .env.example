# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=your-super-secret-key-here-change-this

# Admin Credentials (⚠️ Change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email Configuration (Gmail)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_ENABLED=false

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///database/attendance.db

# Face Data Storage
FACE_DATA_PATH=face_data/encodings.pkl

# Anthropic API (optional, for AI assistant)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Server Port
PORT=5000
